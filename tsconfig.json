{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@layouts/*": ["src/layouts/*"],
      "@hooks/*": ["src/hooks/*"],
      "@pages/*": ["src/pages/*"],
      "@utils/*": ["src/utils/*"],
      "@components/*": ["src/components/*"],
      "@routes/*": ["src/routes/*"],
      "@theme/*": ["src/theme/*"],
      "@sections/*": ["src/sections/*"],
      "@mock": ["src/_mock"],
      "@mock/*": ["src/_mock/*"]
    }
  }
}
